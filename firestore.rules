rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document and all user-scoped health & habit subcollections
    // (period_logs, symptoms, reminders, water, bookmarks)
    // Strictly private: each user can ONLY read and write their OWN documents.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    // Recommended care products: Publicly readable by all users, writable only by admin / server
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Self Care video library: Publicly readable by all users, writable only by admin / server
    match /selfCareVideos/{videoId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Platform feedback submissions: Any authenticated user can submit feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
